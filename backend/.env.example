# ============================================================
# PLATAFORMA DE VALIDACION DEL PERFIL DE EGRESO
# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y edita los valores segun tu entorno:
#   cp .env.example .env
# ============================================================

# --- Comentarios con LLM (opcional) -------------------------
# Si quieres comentarios generados por IA en las celdas del heatmap,
# descomenta el proveedor que uses y agrega tu API key.
# Sin esto, el sistema funciona igual con comentarios locales.
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Dispositivo de embeddings ------------------------------
# "auto" detecta GPU NVIDIA si esta disponible, sino usa CPU.
# "cpu" fuerza CPU siempre.
# "cuda" fuerza GPU (falla si no hay drivers NVIDIA).
# EMBEDDING_DEVICE=auto

# --- Base de datos ------------------------------------------
# Solo necesario para instalacion manual (sin Docker).
# Con Docker Compose, la URL se configura automaticamente.
# DATABASE_URL=postgresql+psycopg://perfil:perfil@localhost:5432/perfil_egreso

# --- Logging ------------------------------------------------
# LOG_LEVEL=INFO
